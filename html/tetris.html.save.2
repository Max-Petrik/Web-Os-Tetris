<!DOCTYPE html>
<html lang="de">
<head>
	<meta charset="UTF-8">
	<title>Web/OS-Tetris</title>
	<link rel="preconnect" href="https://font.googleapis.com">
	<link rel="preconnect" href="https://gstatic.com" crossorigin>
	<link rel="stylesheet" href="font.gooleapis.com/css2?family=Aktwght@100..900display=swap">
	<link rel="stylesheet" href="css/tetris.css" type="text/css">
</head>
<body>
	<div class="scoreboard">
		
	</div>
	<div class="gameField">
		<!-- definiert ein canvas-panel auf dem gezeichnet werden kann -->
		<canvas id="gameCanvas" width="600" height="1100"></canvas>	
	</div>
	<div class="infoBlock">
		<div class="punkteBlock">	
			<h1>Score: </h1>
			<h2 id="scoreText">80 Punkte</h2>	<!-- gibt den score an (eine reihe = 10 Pkt.) -->
			<h1>Level:</h1>		
			<h2 id="levelText">1</h2>		<!-- gibt das Level an, Level bestimmt die Geschwindigkeit -->
		</div>
		<div class="textNextBlock">
			<h1>Nächster Block:</h1>
		</div>
		<div class="imgNextBlock">			<!-- innerhalb dieses Divs wird der nächste Block gezeichnet -->
			
		</div>
	</div>

<script>

	let speed = 220; // Faktor zur Erhöhung der Fallgeschwindigkeit der Blöcke
	let colors = ["#eb0000", "#ff6200", "#ffbb00", "#0ac900", "#0008e6", "#00baf2", "#7b00bd"]; // Farbpalette
	let fld = []; // Felder Besetzung
	let block;
	let loose = false;
	let score = 80;
	let level = 1;

	for(let i = 0; i < 22; i++){
		fld[i] = [];
		for(let j = 0; j < 12; j++){
			fld[i][j] = [];
			fld[i][j][0] = false;		// Index [i][j][0] sagt ob das Feld belegt ist (0 nein / 1 ja); Index [i][j][1] gibt den Farbcode
			fld[i][j][1] = "0";
			if(i == 21 || j == 0 || j == 11){
				fld[i][j][0] = true;
			}		
		}
	}	

	const canvas = document.getElementById("gameCanvas");
	const draw = canvas.getContext("2d");
	
	class iBlock{		
		constructor(color){
			this.color = color;
			this.pos = [[250,150],[200,150],[300,150],[350,150]];		
		}
	}
	class z1Block{		
		constructor(color){
			this.color = color;
			this.pos = [[300,150],[250,150],[300,100],[350,100]];		
		}
	}
	class z2Block{		
		constructor(color){
			this.color = color;
			this.pos = [[300,150],[250,100],[300,100],[350,150]];		
		}
	}
	class l1Block{		
		constructor(color){
			this.color = color;
			this.pos = [[300,150],[250,150],[250,100],[350,150]];		
		}
	}
	class l2Block{		
		constructor(color){
			this.color = color;
			this.pos = [[300,150],[250,150],[350,100],[350,150]];		
		}
	}
	class oBlock{		
		constructor(color){
			this.color = color;
			this.pos = [[250,150],[300,150],[300,100],[250,100]];		
		}
	}
	class tBlock{		
		constructor(color){
			this.color = color;
			this.pos = [[300,150],[250,150],[300,100],[350,150]];		
		}
	}
	const blocks = [iBlock, z1Block, z2Block, l1Block, l2Block, oBlock, tBlock];
	newBlock();
	
	for(let i = 0; i < 22; i++){
		for(let j = 0; j < 12; j++){
			if(i == 0 || i == 21 || j == 0 || j == 11){
				if(j == 0 || j == 21){
					fld[i][j][0] = 1;
				}
				draw.fillStyle = "#404040";
				draw.fillRect(0+j*50, 0+i*50, 50, 50);
				draw.fillStyle = "gray";
				draw.fillRect(7+j*50, 7+i*50, 36, 36);
				drawFld();
			}
		}	
	}

	document.addEventListener("keydown", handleInput);
	function handleInput(e){
		if(e.key == "w" || e.key == "ArrowUp" || e.key == " "){
			if(block.constructor.name != "oBlock"){
				rotateBlock();
			}
		}else if(e.key == "a" || e.key == "ArrowLeft"){
			check = true;
			for(let i = 0; i < 4; i++){
				if(fld[Math.floor(block.pos[i][1]/50)][Math.floor(block.pos[i][0]/50)-1][0] == 1){
					check = false;
					break;
				}
			}
			if(check){
				for(let i = 0; i < 4; i++){
					block.pos[i][0] -= 50;	
				}
			}
		}else if(e.key == "d" || e.key == "ArrowRight"){
			check = true;
			for(let i = 0; i < 4; i++){
				if(fld[Math.floor(block.pos[i][1]/50)][Math.floor(block.pos[i][0]/50)+1][0] == 1){
					check = false;
					break;
				}
				// console.log(check);
			}
			if(check){
				for(let i = 0; i < 4; i++){
					block.pos[i][0] += 50;
				}
			}
		}else if(e.key == "s" || e.key == "ArrowDown"){
			for(let i = 0; i < 10; i++){
				move();
			}
		}
	}

	function move(){
		for(let i = 0; i < 4; i++){
			if(!collision(Math.floor(block.pos[i][1]/50), Math.floor(block.pos[i][0]/50))){
				block.pos[i][1] += 1; // Anzahl der Pixel die pro tick bewegt werden
			}else{	
				break;
			}
		}
		drawFld();
	}

 	function checkForLoose(){
		for(let i = 0; i < 4; i++){
			if(block.pos[i][1] <= 249){
				loose = true;
			}
		}
	}
	
	let tmpPos = [];
	for(let i = 0; i < 4; i++){
		tmpPos[i] = [];
	}

	function rotateBlock(){
		let nullX = block.pos[0][0];
		let nullY = block.pos[0][1];
		for(let i = 0; i < 4; i++){
			block.pos[i][0] -= nullX;
			block.pos[i][1] -= nullY;
		}
		for(let i = 1; i < 4; i++){
			tmp = block.pos[i][0];
			block.pos[i][0] = block.pos[i][1] * -1;
			block.pos[i][1] = tmp; 
		}
		for(let i = 0; i < 4; i++){
			block.pos[i][0] += nullX;
			block.pos[i][1] += nullY;
		}
	}

	function drawFld(){
		draw.fillStyle = "#000033";
		draw.fillRect(50, 50, 500, 1000);
		draw.fillStyle = block.color;
		
		for(let i = 0; i < 4; i++){
			draw.fillRect(0+block.pos[i][0], 0+block.pos[i][1], 50, 50);
		}
		for(let i = 1; i < 21; i++){
			for(let j = 0; j < 12; j++){
				if(fld[i][j][0] == true && fld[i][j][1] != false){
					draw.fillStyle = fld[i][j][1];
					draw.fillRect(0+j*50, 0+i*50, 50, 50);
				}
			}
		}
		draw.fillStyle = "#ff0000";
		draw.fillRect(50, 245, 500, 5);
	}

	function deleteRow(i){
		for(let j = 1; j < 11; j++){
			fld[i][j][0] = false;
		}
		for(let k = i; k > 1; k--){
			for(let l = 1; l < 11; l++){
				fld[k][l][0] = fld[k-1][l][0];
				fld[k][l][1] = fld[k-1][l][1];
			}
		}
		score += 10;
		document.getElementById("scoreText").textContent = score + " Punkte";
		if(score/level >= 100){
			level += 1;
			if(level <= 10){
			 	speed += 20;
			}
		}
		document.getElementById("levelText").textContent = level + "";
	}

	function checkForKill(){
		for(let i = 1; i < 21; i++){
			let tmpCount = 0;
			for(let j = 1; j < 11; j++){
				if(fld[i][j][0] == true){
					tmpCount += 1;
				}
			}
			if(tmpCount == 10){
				deleteRow(i);
			}
		}
	}

	function collision(x, y){
		readyToMove = false;
		if(fld[x+1][y][0] == true){
			for(let i = 0; i < 4; i++){
				fld[Math.floor(block.pos[i][1]/50)][Math.floor(block.pos[i][0]/50)][0] = true;
				fld[Math.floor(block.pos[i][1]/50)][Math.floor(block.pos[i][0]/50)][1] = block.color;
			}
			checkForLoose();
			newBlock();
			checkForKill();
			return true;
		}
	}

	function newBlock(){


		let RandomBlock = blocks[Math.floor(Math.random() * blocks.length)];
		let randomColor = colors[Math.floor(Math.random() * colors.length)]
		block = new RandomBlock(randomColor);
	}	

 	let intervalID;
	let lastTime = 0;
	let fallProgress = 0;
	let deltaTime = 0;

	function clock(timeStamp){
		if(loose){
			return;
		}
		deltaTime = (timeStamp - lastTime) / 1000;		
		lastTime = timeStamp;	
	
		fallProgress += speed * deltaTime;

		while(fallProgress >= 1){
			move();
			fallProgress--;
		}

		requestAnimationFrame(clock);
	}	

	requestAnimationFrame(clock);
	
</script>

</body>
</html>
